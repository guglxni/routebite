        </mxCell>

        <mxCell id="s4a" value="&lt;b&gt;now&lt;/b&gt;&lt;br&gt;place immediately&lt;br&gt;halt-gate check (train)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="150" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="s4b" value="&lt;b&gt;auto / deferred&lt;/b&gt;&lt;br&gt;persist autoPlaceAt&lt;br&gt;deferred-placer tick 20s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=10;align=center;" vertex="1" parent="1">
