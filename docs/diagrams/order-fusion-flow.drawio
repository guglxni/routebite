        <mxCell id="s6" value="&lt;b&gt;6. Dual-clock tracking&lt;/b&gt;&lt;br&gt;GET /orders/:id/track&lt;br&gt;customer ETA vs rider ETA&lt;br&gt;alignment score · rider brief" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=11;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="160" y="930" width="200" height="90" as="geometry"/>
