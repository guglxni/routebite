        <mxCell id="s7" value="&lt;b&gt;re-intercept&lt;/b&gt;&lt;br&gt;POST …/re-intercept&lt;br&gt;flush cart · new stop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=10;align=center;" vertex="1" parent="1">
