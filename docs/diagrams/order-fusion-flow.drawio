        </mxCell>

        <mxCell id="s4c" value="&lt;b&gt;hop-pack / multi-hop&lt;/b&gt;&lt;br&gt;POST /orders/hop-pack&lt;br&gt;corridor packing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="420" y="680" width="160" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="s5" value="&lt;b&gt;5. Swiggy MCP place_order&lt;/b&gt;&lt;br&gt;JSON-RPC · address confirm&lt;br&gt;payment / COD coupon caps&lt;br&gt;encrypt token vault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontSize=11;align=center;spacing=4;" vertex="1" parent="1">
