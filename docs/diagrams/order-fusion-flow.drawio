<mxfile host="app.diagrams.net" agent="RouteBite" version="24.7.8" type="device">
  <diagram id="order-flow" name="Order &amp; Fusion Flow">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t" value="RouteBite — Journey → Intercept → Order → Alignment (BPMN-style flowchart)" style="text;html=1;fontStyle=1;fontSize=16;fontColor=#1e293b;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="720" height="28" as="geometry"/>
        </mxCell>

        <!-- Start -->
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#16a34a;strokeColor=#15803d;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="36" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="start-l" value="Start" style="text;html=1;fontSize=10;fontColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="70" y="118" width="56" height="16" as="geometry"/>
        </mxCell>

        <mxCell id="s1" value="&lt;b&gt;1. Plan journey&lt;/b&gt;&lt;br&gt;POST /routes/analyze&lt;br&gt;origin · destination · mode&lt;br&gt;(drive / two-wheeler / train)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=11;align=center;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="160" y="60" width="200" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="d1" value="transportMode&#xa;= train?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="200" y="180" width="120" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="s1a" value="&lt;b&gt;NTES live run&lt;/b&gt;&lt;br&gt;GET /railways/:n/run&lt;br&gt;halt ETAs + trajectory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#4f46e5;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="180" width="160" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="s2" value="&lt;b&gt;2. Intercept scoring&lt;/b&gt;&lt;br&gt;corridor + Places + weather&lt;br&gt;isochrone reachability&lt;br&gt;selectTopK scored stops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=11;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="160" y="300" width="200" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="s3" value="&lt;b&gt;3. Commerce browse&lt;/b&gt;&lt;br&gt;restaurants / Instamart&lt;br&gt;menu-search · deepen&lt;br&gt;honesty: Maps vs Swiggy ETA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontSize=11;align=center;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="160" y="430" width="200" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="d2" value="timing&#xa;mode?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=10;" vertex="1" parent="1">
