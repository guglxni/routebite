        <mxCell id="c8" value="auto" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1;strokeColor=#d97706;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="1" source="d2" target="s4b"><mxGeometry relative="1" as="geometry"/></mxCell>
