# Copy to .env.mvp (never commit). Used by Docker / Openship for the AWS Lightsail MVP.

ENCRYPTION_KEY=
GOOGLE_MAPS_API_KEY=
# Optional browser key baked at image build time:
# VITE_GOOGLE_MAPS_API_KEY=

NODE_ENV=production
PORT=8080
SERVE_WEB=1
WEB_DIST=/app/apps/web/dist
DATABASE_URL=file:/data/routebite.db

# After Openship assigns a domain / IP URL, set this to the public origin:
WEB_ORIGIN=http://REPLACE_WITH_PUBLIC_URL

# Keep mock Swiggy off for MVP unless you run it separately
SWIGGY_MCP_BASE=
SWIGGY_CLIENT_ID=
SWIGGY_REDIRECT_URI=
