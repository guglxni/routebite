# RouteBite API — copy to .env and fill in values. Never commit .env.

# Required: 32-byte key as 64-char hex OR any string (SHA-256 derived)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# Google Maps Platform (Routes, Geocoding, Places, Weather, Isochrones, Air Quality, Pollen)
# Prefer a server-only key (IP-restricted). Do not use an unrestricted browser key here.
GOOGLE_MAPS_API_KEY=
# Optional: Cloud Route Optimization API project id
# GOOGLE_CLOUD_PROJECT=gmp-demo-project-713039209
# Optional split (recommended for prod):
# GOOGLE_MAPS_API_KEY_SERVER=
# GOOGLE_MAPS_API_KEY_CLIENT=   # referrer-restricted; Maps JS / Places UI Kit
# GOOGLE_MAP_ID=

# SQLite (default) or Turso/libSQL for production
DATABASE_URL=file:./local.db
# DATABASE_AUTH_TOKEN=

# Server
PORT=8787
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# Rate limiting — set for multi-instance production (Upstash, ElastiCache, etc.)
# REDIS_URL=redis://localhost:6379

# Structured JSON access + security logs (auto-enabled when NODE_ENV=production)
# STRUCTURED_LOGS=1

# Swiggy MCP (Builders Club: https://mcp.swiggy.com/builders/docs/)
# Local mock: food → POST /food, instamart → POST /im
# Live:       https://mcp.swiggy.com  (same path segments)
SWIGGY_MCP_BASE=http://localhost:8788
SWIGGY_CLIENT_ID=routebite-dev
SWIGGY_REDIRECT_URI=http://localhost:3000/auth/callback

# Dev-only (mock Swiggy + seed script — never use in production)
# DEV_SESSION_TOKEN=routebite-dev-session
# MOCK_DEV_ACCESS_TOKEN=routebite-dev-token

# NTES (Indian Railways live status — optional tuning)
# NTES_TIMEOUT_MS=12000
# NTES_RETRIES=2
