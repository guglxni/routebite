# Client-side Google Maps (Places UI Kit Autocomplete). Prefer a referrer-restricted key.
# Leave empty to use demo datalist fallback for origin/destination.
VITE_GOOGLE_MAPS_API_KEY=
# Optional alias:
# VITE_GOOGLE_MAPS_API_KEY_CLIENT=
# VITE_GOOGLE_MAP_ID=

# Dev session shortcut (optional)
# VITE_DEV_SESSION_TOKEN=routebite-dev-session
